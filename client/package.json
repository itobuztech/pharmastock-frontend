{
  "name": "pharmastock-client-app",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint src/**/*.ts{,x} --max-warnings=0",
    "lint-staged": "lint-staged",
    "fetch-schema": "npx apollo client:download-schema",
    "codegen": "graphql-codegen --config codegen.ts",
    "commit": "git-cz",
    "release": "standard-version"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint src/**/*.ts{,x} --max-warnings=0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@digitalroute/cz-conventional-changelog-for-jira",
      "jiraPrefix": ""
    }
  },
  "dependencies": {
    "@apollo/client": "^3.11.1",
    "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
    "@emotion/react": "^11.11.1",
    "@faker-js/faker": "^7.2.0",
    "@hookform/resolvers": "^3.9.0",
    "@mantine/core": "^7.11.2",
    "@mantine/dates": "^7.12.0",
    "@mantine/emotion": "^7.17.2",
    "@mantine/hooks": "^7.11.2",
    "@reduxjs/toolkit": "^1.9.7",
    "@sentry/react": "^7.5.0",
    "@sentry/tracing": "^7.5.0",
    "@testing-library/react": "^14.2.1",
    "@types/react-select-country-list": "^2.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "axios": "^1.4.0",
    "commitizen": "^4.3.0",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.12",
    "envalid": "^8.0.0",
    "graphql": "^15.5.0",
    "libphonenumber-js": "^1.11.5",
    "lodash": "^4.17.21",
    "postcss-import": "^16.1.0",
    "query-string": "^7.0.1",
    "react": "^18.2.0",
    "react-datepicker": "^7.3.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.32.1",
    "react-icons": "^4.10.1",
    "react-range": "^1.9.2",
    "react-redux": "^8.0.2",
    "react-router-dom": "^6.17.0",
    "react-select-country-list": "^2.2.3",
    "react-toastify": "^10.0.5",
    "redux-saga": "^1.1.3",
    "rollup-plugin-react-scoped-css": "^1.0.0",
    "vite": "^5.3.1",
    "vite-tsconfig-paths": "^4.3.1",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.6",
    "@commitlint/config-conventional": "^17.6.6",
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/client-preset": "4.3.0",
    "@graphql-codegen/introspection": "4.0.3",
    "@tailwindcss/typography": "^0.5.9",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.195",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.9",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "autoprefixer": "^10.4.14",
    "dotenv-cli": "^4.0.0",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.34.3",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.2",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.9.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^2.7.1",
    "sass": "^1.52.3",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.3.2",
    "typescript": "^4.7.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-pwa": "^0.19.8",
    "web-vitals": "^3.3.2"
  },
  "packageManager": "yarn@4.5.1"
}
